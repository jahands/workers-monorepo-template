{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "{{ slug name }}",
	"main": "src/{{ slug name }}.app.ts",
	"compatibility_date": "2026-06-04",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1 // 100%
		}
	},
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"ENVIRONMENT": "development", // overridden during deployment
		"RELEASE": "unknown", // overridden during deployment
		"NAME": "{{ slug name }}"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"workflows": [
		{
			"name": "{{ pascal workflowName }}",
			"binding": "{{ pascal workflowName }}",
			"class_name": "{{ pascal workflowName }}"
		}
	],
	"upload_source_maps": true
}
