{
	"name": "@repo/wrangler-config",
	"version": "0.1.0",
	"private": true,
	"description": "Write your Wrangler config in TypeScript via wrangler.config.ts",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"main": "./src/index.ts",
	"bin": {
		"wrangler-config": "./bin/wrangler-config"
	},
	"scripts": {
		"check:lint": "run-oxlint",
		"check:types": "run-tsc",
		"test": "run-vitest",
		"update-schema": "bun run ./scripts/generate-schema.ts && prettier --write ./src/schema.ts"
	},
	"dependencies": {
		"jsonc-parser": "3.3.1"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "14.0.0",
		"@jahands/cli-tools": "0.11.4",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"p-filter": "4.1.0",
		"p-map": "7.0.4",
		"vite": "7.3.5",
		"vitest": "4.1.5",
		"wrangler": "4.111.0",
		"zod": "4.3.6",
		"zx": "8.8.5"
	}
}
